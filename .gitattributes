# Normalize source code without rewriting problem input/output fixtures.
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.rs text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.cmd text eol=crlf
